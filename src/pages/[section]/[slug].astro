---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from '../../components/Toc.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import PolicyNotice from '../../components/PolicyNotice.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { getPosts, getSeriesPosts, tagToSlug, shortUrl, type Post } from '../../lib/posts';
import { formatDate, readingTime } from '../../lib/format';
import { SITE, getSection } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { section: post.data.section, slug: post.data.slug },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { data } = post;
const section = getSection(data.section);

const { Content, headings } = await render(post);
const minutes = readingTime(post.body ?? '');
const seriesPosts = data.series ? await getSeriesPosts(data.series) : [];

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = `/og/${data.section}/${data.slug}.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.summary,
  datePublished: data.date.toISOString(),
  dateModified: (data.updated ?? data.date).toISOString(),
  author: { '@type': 'Person', name: SITE.author, url: `${SITE.url}/about/` },
  publisher: { '@type': 'Person', name: SITE.author },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  image: new URL(ogImage, SITE.url).href,
  inLanguage: 'zh-Hans',
  articleSection: section.title,
  keywords: data.tags.join(', ') || undefined,
};
---

<BaseLayout
  title={data.title}
  description={data.summary}
  ogImage={ogImage}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="wrap post">
    <header class="post__header">
      <a class="post__section" href={`/${data.section}/`}>{section.title}</a>

      <h1 class="post__title" data-pagefind-meta="title">
        {data.title}
        {data.draft && <span class="draft-badge">草稿</span>}
      </h1>

      <div class="post__meta">
        <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
        {
          data.updated && (
            <span>更新于 {formatDate(data.updated)}</span>
          )
        }
        <span>约 {minutes} 分钟</span>
      </div>

      {data.policyAsOf && <PolicyNotice asOf={data.policyAsOf} />}
    </header>

    {
      data.cover && (
        <Image
          class="post__cover"
          src={data.cover}
          alt={`《${data.title}》封面`}
          widths={[640, 960, 1280]}
          sizes="(max-width: 40rem) 100vw, 40rem"
          format="webp"
          loading="eager"
        />
      )
    }

    <Toc headings={headings} />

    <div class="prose" data-pagefind-body>
      <Content />
    </div>

    {
      data.xhsUrl && (
        <p class="post__xhs">
          本文的精简版发在小红书：
          <a href={data.xhsUrl}>点这里看</a>
        </p>
      )
    }

    {
      data.tags.length > 0 && (
        <div class="post__tags">
          {data.tags.map((tag) => (
            <a class="tag-pill" href={`/tags/${tagToSlug(tag)}/`}>
              {tag}
            </a>
          ))}
        </div>
      )
    }

    {
      data.series && seriesPosts.length > 1 && (
        <SeriesNav series={data.series} posts={seriesPosts} current={post} />
      )
    }

    {section.disclaimer && <Disclaimer />}

    <p class="post__short">
      分享短链：<code>{new URL(shortUrl(post), SITE.url).href}</code>
    </p>
  </article>
</BaseLayout>

<style>
  .post {
    padding-bottom: 1rem;
  }

  .post__header {
    margin-top: 2.5rem;
  }

  .post__section {
    font-size: 0.86rem;
    color: var(--text-muted);
  }

  .post__title {
    margin: 0.5rem 0 0.7rem;
    font-family: var(--font-serif);
    font-size: 1.95rem;
    line-height: 1.4;
    font-weight: 600;
  }

  .post__title .draft-badge {
    vertical-align: middle;
    margin-left: 0.5rem;
    font-size: 0.85rem;
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    color: var(--text-faint);
    font-size: 0.86rem;
    font-variant-numeric: tabular-nums;
  }

  .post__cover {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 2rem;
    border-radius: 4px;
  }

  .prose {
    margin-top: 2.5rem;
  }

  .post__xhs {
    margin-top: 2.5rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg-subtle);
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 2.5rem;
  }

  .post__short {
    margin-top: 2.5rem;
    color: var(--text-faint);
    font-size: 0.84rem;
    word-break: break-all;
  }

  .post__short code {
    font-family: var(--font-mono);
    font-size: 0.95em;
  }

  @media (max-width: 34rem) {
    .post__title {
      font-size: 1.5rem;
    }
  }
</style>
