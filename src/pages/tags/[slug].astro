---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getAllTags, getPostsByTag, tagToSlug, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return Promise.all(
    tags.map(async ({ tag }) => ({
      params: { slug: tagToSlug(tag) },
      props: { tag, posts: await getPostsByTag(tag) },
    }))
  );
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout
  title={`标签：${tag}`}
  description={`标记为「${tag}」的全部文章，共 ${posts.length} 篇。`}
>
  <div class="wrap">
    <h1 class="page-title">#{tag}</h1>
    <p class="page-lede">标记为「{tag}」的文章共 {posts.length} 篇，跨栏目聚合。</p>

    <PostList posts={posts} showSection />
  </div>
</BaseLayout>
